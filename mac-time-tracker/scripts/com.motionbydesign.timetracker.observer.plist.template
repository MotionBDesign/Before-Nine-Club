<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.motionbydesign.timetracker.observer</string>

  <!--
    launchd starts this binary directly, which is the whole point: macOS then
    attributes the Accessibility permission to the observer itself rather than to
    whatever process spawned it. Grant the permission to the path below.
  -->
  <!--
    The flags belong to the compiled Swift observer. The applet takes none at
    all -- an AppleScript applet treats stray argv as an open request -- so the
    installer renders __OBSERVER_ARGS__ empty for it and reads the interval
    from config.json instead.
  -->
  <key>ProgramArguments</key>
  <array>
    <string>__OBSERVER__</string>
    __OBSERVER_ARGS__
  </array>

  <key>RunAtLoad</key>
  <true/>

  <!--
    Always restart. The applet observer deliberately quits every couple of
    hours so a fresh process replaces it -- AppleScript's runtime is not built
    to live for weeks -- and with SuccessfulExit:false a clean quit would have
    ended tracking until the next login. ThrottleInterval below still bounds a
    genuine crash loop.
  -->
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/mbd-time-tracker.observer.log</string>
</dict>
</plist>
