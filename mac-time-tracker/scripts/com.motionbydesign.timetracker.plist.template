<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.motionbydesign.timetracker</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>__REPO__/daemon/src/index.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__REPO__/daemon</string>

  <key>RunAtLoad</key>
  <true/>

  <!-- Restart if it crashes, but not if it exited cleanly (a deliberate quit). -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>ProcessType</key>
  <string>Background</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/mbd-time-tracker.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/mbd-time-tracker.err.log</string>
</dict>
</plist>
